rules_version = '2';

// Multi-tenant isolation with a platform super-admin layer.
service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myCompanyId() {
      return myProfile().companyId;
    }
    function canManageUsers() {
      return myProfile().roleId == 'owner' || myProfile().roleId == 'manager';
    }
    function isOwner(companyId) {
      return myProfile().roleId == 'owner' && myProfile().companyId == companyId;
    }

    // Platform super-admin(s). Keep this list in sync with
    // lib/core/platform/platform_admin.dart (kPlatformAdminEmails).
    function isPlatformAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['admin@nexora.net', 'codewithshakil@gmail.com'];
    }

    // A tenant may edit its own company profile but NOT its subscription
    // (status / plan / expiry) — those are admin-only.
    function subscriptionUnchanged() {
      return request.resource.data.status == resource.data.status &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.planExpiresAt == resource.data.planExpiresAt;
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (request.auth != null && (
        request.auth.uid == userId ||
        resource.data.companyId == myCompanyId()
      ));
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        (canManageUsers() &&
          request.resource.data.companyId == myCompanyId())
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (canManageUsers() && resource.data.companyId == myCompanyId())
      );
    }

    match /companies/{companyId} {
      // Admin sees all; members see their own.
      allow read: if isPlatformAdmin() ||
        (request.auth != null && myCompanyId() == companyId);

      // Signup creates the company (as pending).
      allow create: if request.auth != null;

      // Admin can change anything (incl. subscription). The owner can change
      // company settings but not the subscription fields.
      allow update: if isPlatformAdmin() ||
        (isOwner(companyId) && subscriptionUnchanged());

      // Business data under the company inherits membership-based access.
      match /{document=**} {
        allow read, write: if request.auth != null && myCompanyId() == companyId;
      }
    }
  }
}
